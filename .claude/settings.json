{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cargo fmt --all 2>&1",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Formatting (cargo fmt)…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo clippy --workspace --all-features -- -D warnings 2>&1",
            "shell": "powershell",
            "timeout": 120,
            "statusMessage": "Linting (cargo clippy)…"
          }
        ]
      }
    ]
  }
}
